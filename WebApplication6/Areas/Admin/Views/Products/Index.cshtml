@model IEnumerable<WebApplication6.Models.Product>

@{
    ViewData["Title"] = "Index";
}

<h1>محصولات</h1>

<p>
    <a class="btn btn-success" asp-action="Create">ایجاد</a>
</p>
<table class="table text-center">
    <thead>
        <tr>
            <th>
                نام
            </th>
            <th>
                توضیحات
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ImageUrl)
            </th>
            <th>
                قیمت
            </th>
            <th>
                موجودی
            </th>
            <th>
                تاریخ ایجاد
            </th>
            <th>
                دسته بندی
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ImageUrl)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Price)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Stock)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CreatedAt)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Category.Name)
                </td>
                <td>
                    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@item.Id">ویرایش</a> 
                    <a class="btn btn-primary" asp-action="Details" asp-route-id="@item.Id">جزییات</a> 
                    <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.Id">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>
