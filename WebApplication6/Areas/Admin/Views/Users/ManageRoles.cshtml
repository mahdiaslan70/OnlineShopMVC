@model List<ManageRolesViewModel>
@{
    ViewBag.Title = "مدیریت نقش‌ها برای " + ViewBag.UserName;
}

<h3>@ViewBag.Title</h3>

<form asp-action="ManageRoles" method="post">
    <input type="hidden" name="id" value="@ViewBag.UserId" />
    <div class="form-group">
        @for (int i = 0; i < Model.Count; i++)
        {
            <div class="form-check">
                <input asp-for="@Model[i].IsSelected"  />
                <label asp-for="@Model[i].IsSelected" class="form-check-label">@Model[i].RoleName</label>
                <input type="hidden" asp-for="@Model[i].RoleName" />
            </div>
        }
    </div>
    <button type="submit" class="btn btn-success mt-3">ذخیره</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">بازگشت</a>
</form>
