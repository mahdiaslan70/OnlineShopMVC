@model Category

<h3 class="text-center m-3">ایجاد دسته بندی</h3>

<div class="row d-flex justify-content-center">
    <div class="col-md-4" style="margin-top: 100px;">
        <form asp-action="Add">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group d-flex align-items-center">
                <label asp-for="Name" class="form-label mb-0" style="width: 50px;"></label>
                <input asp-for="Name" class="form-control" placeholder="نام دسته بندی"/>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="d-flex justify-content-center" style="margin-top: 15px;">
                <button class="btn btn-primary" type="submit">ایجاد</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
