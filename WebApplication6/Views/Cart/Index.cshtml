@model List<CartItem>

@if (Model != null && Model.Count > 0)
{
    <a asp-controller="Cart" asp-action="ClearCart" asp-route-userId="@ViewBag.UserId" class="btn btn-danger mb-3">حذف همه</a>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>شماره سفارش</th>
                <th>نام محصول</th>
                <th>تعداد</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Product.Name</td>
                    <td>
                        <form method="post" asp-area="Admin" asp-controller="Order" asp-action="AddToOrders">
                            <input type="number" name="quantity" value="@item.Quantity" />
                            <button type="submit">نهایی کردن خرید</button>
                        </form>
                    </td>
                    <td>
                        <a asp-controller="Cart" asp-action="RemoveFromCart" asp-route-cartItemId="@item.Id" class="btn btn-danger">حذف</a>
                    </td>

                </tr>
            }
        </tbody>
    </table>

    <!-- دکمه -->
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#confirmModal">نهایی کردن خرید</button>

    <!-- Modal -->
    <div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-end">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmModalLabel">تایید خرید</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
                </div>
                <div class="modal-body">
                    آیا از نهایی کردن خرید مطمئن هستید؟
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">لغو</button>
                    @* <a class="btn btn-success" asp-area="Admin" asp-controller="Order" asp-action="AddToOrders">تایید</a> *@

                </div>
            </div>
        </div>
    </div>

    <!-- اسکریپت -->
    @section Scripts {
    <script>
        function finalizePurchase() {
            alert("خرید نهایی شد!");
            // می‌تونی اینجا فرم بفرستی یا ریدایرکت کنی
            const modal = bootstrap.Modal.getInstance(document.getElementById('confirmModal'));
            modal.hide();
        }
    </script>
    }

}

else
{
    <h5>سبد خرید شما خالی میباشد</h5>
}