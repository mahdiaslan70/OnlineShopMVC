@model List<OrderItem>

<h5 class="text-center m-4">سفارشات نهایی شده</h5>

<div class="d-flex justify-content-center text-center">

    <table class="table table-striped w-50">
        <thead>
            <tr>
                <th>شماره سفارش</th>
                <th>شماره کاربر</th>
                <th>نام کاربر</th>
                <th>نام محصول</th>
                <th>قیمت واحد</th>
                <th>تعداد</th>
                <th>قیمت نهایی</th>
                <th>تاریخ ثبت سفارش</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Order.Id</td>
                    <td>@item.Order.UserId</td>
                    <td>@item.Order.User.FullName</td>
                    <td>@item.Product.Name</td>
                    <td>@item.UnitPrice</td>
                    <td>@item.Quantity</td>
                    <td>@(item.UnitPrice*item.Quantity)</td>
                    <td>@item.Order.OrderedAt</td>

                </tr>
            }

        </tbody>
    </table>
</div>